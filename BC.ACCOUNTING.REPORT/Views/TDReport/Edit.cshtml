@model BC.ACCOUNTING.CORE.Entities.TDReport

<h2>Edit Report</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
   // @Html.HiddenFor(m => m.ReportCode)

    <div>
        @Html.LabelFor(m => m.DbCode)
        @Html.TextBoxFor(m => m.DbCode)
    </div>
    <div>
        @Html.LabelFor(m => m.ReportName)
        @Html.TextBoxFor(m => m.ReportName)
    </div>
   
    <div>
        @Html.LabelFor(m => m.Status)
        @Html.TextBoxFor(m => m.Status)
    </div>
    
    <button type="submit">Update</button>
}